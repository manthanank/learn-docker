{
  "name": "learn-docker",
  "version": "1.3.0",
  "description": "Authoritative enterprise curriculum, container internals simulator, Dockerfile AST linter, OverlayFS & Linux isolation lab, and interactive web sandbox.",
  "main": "dist/index.js",
  "bin": {
    "learn-docker": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "node dist/cli.js lint Dockerfile"
  },
  "keywords": [
    "docker",
    "container",
    "oci",
    "runc",
    "containerd",
    "cgroups",
    "namespaces",
    "overlayfs",
    "dockerfile",
    "docker-compose",
    "devops",
    "kubernetes"
  ],
  "author": "Manthan Ankolekar",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
